{
  "mcpServers": {
    "vulnhub": {
      "command": "python3",
      "args": ["/srv/vulnhub/mcp/vulnhub_mcp.py"],
      "env": {
        "VULNHUB_URL": "https://your-domain.example",
        "VULNHUB_USER": "vulnhub-mcp",
        "VULNHUB_TOKEN_FILE": "/srv/vulnhub/.mcp_token"
      }
    }
  }
}
